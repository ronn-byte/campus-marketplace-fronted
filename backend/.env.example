NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://:@:5432/campus_marketplace_dev?sslmode=require
# Dedicated test database; required by database-backed backend tests.
TEST_DATABASE_URL=postgresql://:@:5432/campus_marketplace_test?sslmode=require
CORS_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=cm_session
SESSION_TTL_HOURS=720
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=48
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=noreply@example.test
APP_URL=http://localhost:3000
# SMTP settings are required only when EMAIL_PROVIDER=smtp.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=replace-with-google-app-password
# Base64-encoded 32-byte key used to encrypt private student verification data.
STUDENT_DATA_ENCRYPTION_KEY=
